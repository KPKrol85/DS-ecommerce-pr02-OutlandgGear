# Dependencies
node_modules/

# Generated production output
/dist/

# Test, coverage and report output
/reports/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.lighthouse-reports/
/.lighthouseci/
/coverage/
/.nyc_output/

# Tool caches and temporary build data
/.cache/
.eslintcache
.stylelintcache

/tmp/
/.temp/
/.tmp/

# Local agent and worktree files
/.claude/
/.worktrees/
/worktrees/

# Codex local files — preserve the tracked environment configuration
/.codex/*
!/.codex/environments/
/.codex/environments/*
!/.codex/environments/environment.toml

# Netlify local files
.netlify/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.history/

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
*:Zone.Identifier

# ─────────────────────────────────────────────
# Intentionally tracked — do not ignore:
#
# assets/img/       required production image assets
# css/              source stylesheets
# data/             product and travel-kit data
# js/               source JavaScript modules
# partials/         shared HTML components
# scripts/          production build pipeline
# tests/            automated project tests
# package-lock.json
# LICENSE.md
# .codex/environments/environment.toml
